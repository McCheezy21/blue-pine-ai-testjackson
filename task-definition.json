{
  "family": "blue-pine-ai-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::947039910131:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::947039910131:role/Chase-test-role",
  "containerDefinitions": [
    {
      "name": "blue-pine-ai-container",
      "image": "947039910131.dkr.ecr.us-east-1.amazonaws.com/chase-blue-test:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "readonlyRootFilesystem": false,
      "user": "1001:1001",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blue-pine-ai",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 1024,
          "hardLimit": 2048
        }
      ]
    }
  ]
} 