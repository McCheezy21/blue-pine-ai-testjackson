{
  "name": "@blue-pine-ai/python-services",
  "version": "1.0.0",
  "description": "Blue Pine AI - Python Services for ML, Automation, and Bedrock Integration",
  "private": true,
  "scripts": {
    "setup": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "install": "pip install -r requirements.txt",
    "dev": "python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "start": "python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "test": "python -m pytest tests/ -v",
    "lint": "flake8 . && black --check .",
    "format": "black .",
    "type-check": "mypy .",
    "clean": "rm -rf __pycache__ .pytest_cache .mypy_cache venv/ *.pyc"
  },
  "keywords": [
    "python",
    "machine-learning",
    "aws-bedrock",
    "automation",
    "healthcare-ai"
  ],
  "engines": {
    "python": ">=3.9"
  }
} 