{
  "name": "@blue-pine-ai/backend",
  "version": "1.0.0",
  "description": "Blue Pine AI - Backend API Server",
  "private": true,
  "type": "commonjs",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
