# Blue Pine AI Multi-Tenant Configuration Template
# Copy this to .env and fill in your values

# ===========================================
# OPTION 1: Gmail SMTP (EASIEST - 2 minutes)
# ===========================================
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication
# 3. Generate App Password for "Mail"
# 4. Use that app password below (NOT your regular Gmail password)

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ===========================================  
# OPTION 2: SendGrid (FREE TIER - 3 minutes)
# ===========================================
# 1. Sign up at https://sendgrid.com/
# 2. Get API key from Settings > API Keys
# 3. Uncomment and fill the lines below

# SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# OPTION 3: AWS SES (Production Grade)
# ===========================================
# Uncomment if you want to use AWS SES instead

# AWS_REGION=us-west-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# SES_FROM_EMAIL=noreply@bluepineai.com

# ===========================================
# REQUIRED: AWS Bedrock Configuration
# ===========================================
# For AI Chatbot functionality using Claude 3.5 Sonnet
# 1. Go to AWS Console > Bedrock > Model access
# 2. Request access to Anthropic Claude models
# 3. Choose ONE authentication method below

# OPTION A: IAM Role (RECOMMENDED for production)
# Create an IAM role with Bedrock permissions and assume it
# For same-account role assumption (no external ID needed)
# AWS_BEDROCK_ROLE_ARN=arn:aws:iam::123456789012:role/BluePineAI-Bedrock-Role
# AWS_BEDROCK_ROLE_SESSION_NAME=BluePineAI-Bedrock-Session

# OPTION B: EC2 Instance Profile / ECS Task Role (RECOMMENDED for AWS deployments)
# No configuration needed - automatically detected when running on:
# - EC2 instances with attached IAM role
# - ECS tasks with task role
# - Lambda functions with execution role

# OPTION C: AWS Profile (RECOMMENDED for development)
# Use AWS CLI configured profile
# AWS_PROFILE=your-aws-profile-name

# OPTION D: Access Keys (NOT RECOMMENDED - use only for testing)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Common settings for all options
AWS_REGION=us-east-1

# ===========================================
# REQUIRED: Database Configuration
# ===========================================
# Replace with your actual RDS endpoint and credentials
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-secure-database-password

# ===========================================
# REQUIRED: AWS Cognito Configuration
# ===========================================
# Your existing Cognito settings
COGNITO_REGION=us-west-1
COGNITO_USER_POOL_ID=us-west-1_ZRp04bdAf
COGNITO_CLIENT_ID=3cqsdhk7qmhvdvt4n9lpvni40q

# ===========================================
# REQUIRED: Application Configuration
# ===========================================
PORT=3001
FRONTEND_URL=http://localhost:8084
NODE_ENV=development

# ===========================================
# REQUIRED: Testing Configuration
# ===========================================
# Use your email for testing email delivery
TEST_EMAIL=your-email@gmail.com

# ===========================================
# QUICK START INSTRUCTIONS:
# ===========================================
# 1. Copy this file to .env
# 2. Choose ONE email option above (Gmail is easiest)
# 3. Fill in your AWS Bedrock credentials for AI chatbot
# 4. Fill in your database credentials
# 5. Set TEST_EMAIL to your email address
# 6. Run: npm run dev
# 7. Test: curl http://localhost:3001/api/admin/test-email
# 8. Test Bedrock: curl http://localhost:3001/api/admin/bedrock/test
# 9. Go to: http://localhost:8084/admin to test invitations! 