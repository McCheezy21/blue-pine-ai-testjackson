# Required secrets for staging deployment
export TF_VAR_db_password="SecureStaging123!@#$(date +%s)"
export TF_VAR_jwt_secret="staging-jwt-secret-$(openssl rand -hex 32)"

# Domain (change this to your actual domain)
export TF_VAR_domain_name="staging.bluepineai.com"
export TF_VAR_alert_email="dev@bluepineai.com"

# AWS Configuration
export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="us-east-1"
